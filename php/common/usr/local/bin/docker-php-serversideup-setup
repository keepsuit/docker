#!/bin/sh

set -e

docker-php-serversideup-dep-install-alpine "bash ffmpeg mysql-client htop"
docker-php-serversideup-dep-install-debian "ffmpeg htop"

# MySQL client doesn't work on alpine
if [ "$OS" != "alpine" ]; then
	echo "🤖 Installing MySQL client..."
	MYSQL_VERSION=8.4.11

	case ${TARGETARCH} in
	"amd64") MYSQL_DIR=mysql-${MYSQL_VERSION}-linux-glibc2.28-x86_64-minimal ;;
	"arm64") MYSQL_DIR=mysql-${MYSQL_VERSION}-linux-glibc2.28-aarch64 ;;
	esac
	curl -fsSLO https://dev.mysql.com/get/Downloads/MySQL-8.4/${MYSQL_DIR}.tar.xz
	tar -xf ${MYSQL_DIR}.tar.xz
	mv ${MYSQL_DIR}/bin/mysqldump /usr/local/bin/mysqldump
	chmod +x /usr/local/bin/mysqldump
	rm -rf ${MYSQL_DIR}*
fi

echo "🤖 Installing PIE extensions..."
# Headers and (on alpine) the toolchain are needed only to compile; the runtime libs are installed explicitly so the purge keeps them.
if [ "$OS" = "alpine" ]; then
	apk add --no-cache imagemagick libgomp ghostscript libheif libheif-aom libheif-x265 libjxl libraw librsvg libuv
	apk add --no-cache --virtual .pie-build-deps $PHPIZE_DEPS imagemagick-dev libuv-dev
else
	apt-get update
	apt-get install -y --no-install-recommends libmagickwand-dev libuv1-dev \
		'^libmagickwand-7\.q16-[0-9]+$' '^libmagickcore-7\.q16-[0-9]+-extra$' libheif-plugin-aomenc ghostscript libuv1
fi

# PIE enabling goes through docker-php-ext-enable, whose apk call fails on alpine (nginx repo tag) and leaves a duplicate ini
pie install --skip-enable-extension bsn4/grpc
pie install --skip-enable-extension extport/protobuf
pie install --skip-enable-extension open-telemetry/ext-opentelemetry
pie install --skip-enable-extension imagick/imagick
pie install --skip-enable-extension amphp/uv
for ext in grpc protobuf opentelemetry imagick uv; do
	echo "extension=$ext" >"$PHP_INI_DIR/conf.d/docker-php-ext-$ext.ini"
done

if [ "$OS" = "alpine" ]; then
	apk del .pie-build-deps
else
	apt-get purge -y --auto-remove -o APT::AutoRemove::RecommendsImportant=false libmagickwand-dev libuv1-dev
	rm -rf /var/lib/apt/lists/*
fi

echo "🤖 Installing supercronic..."
curl -fsSL -o supercronic "https://github.com/aptible/supercronic/releases/download/${SUPERCRONIC_VERSION}/supercronic-linux-${TARGETARCH}"
chmod +x supercronic
mv supercronic /usr/local/bin/supercronic

echo "🤖 Fixing composer cache permissions..."
mkdir -p "$COMPOSER_HOME/cache"
chown -R www-data:www-data "$COMPOSER_HOME"
chmod -R u+rwX,g+rwX "$COMPOSER_HOME"
